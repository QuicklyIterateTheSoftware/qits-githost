<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.wohlben.qits</groupId>
        <artifactId>qits-githost</artifactId>
        <version>2026.814.72533</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- The deployable: the git smart-HTTP routes at /git/*, the two storage adapters that put the
         `git-storage` engine's packs and reftables into qits-blobstore, the schema those adapters'
         rows live in, and the publisher that turns a post-receive hook into platform events.

         FOUR SURFACES ON ONE PORT, and the git one is still the reason the others are shaped as
         they are: /git/** is the wire protocol spoken by `git` (raw Vert.x routes, a literal
         prefix no config key moves), /githost/api is JAX-RS, /githost/ is the Angular client
         Quinoa builds out of src/main/webui (the qits-spa-githost submodule), and /githost/q is
         Quarkus' own non-application root, health included.

         The SPA is why quarkus-undertow must stay out — see the quinoa dependency below.

         The adapters can only live HERE: `git-storage` declares the two ports and may not depend on
         qits-blobstore, qits-blobstore knows nothing of git, and this is the one module that
         depends on both. -->
    <artifactId>qits-githost-service</artifactId>
    <name>qits-githost :: service</name>
    <packaging>quarkus</packaging>

    <dependencies>
        <dependency>
            <!-- /githost/q/health/ready — the readiness endpoint qits-cd's health gate curls. -->
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-auth-core</artifactId>
        </dependency>
        <dependency>
            <!-- /githost/q/health/ready — the readiness endpoint qits-cd's health gate curls. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>
        <dependency>
            <!-- The git host's storage engine (a JGit DfsRepository over blobs). -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-githost-git-storage</artifactId>
        </dependency>
        <dependency>
            <!-- The event vocabulary this service publishes. It carries qits-eventstream with it,
                 which is where QitsEventBus, the outbox and their datasource come from. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-githost-events</artifactId>
        </dependency>
        <dependency>
            <!-- The content-addressed blob store: BlobStore is where a pack, a pack index and a
                 reftable are written. Nothing else in this jar is used — this service maps no
                 artifact repository and serves no artifact. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-blobstore</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <!-- The Router these routes register on. Brought in by health too; named because
                 GitHostRoutes observes io.vertx.ext.web.Router directly. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-vertx-http</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-oidc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm-panache</artifactId>
        </dependency>
        <dependency>
            <!-- QuarkusTransaction, which every adapter here opens its own transaction with: the
                 post-receive path runs on a Vert.x worker with none bound. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-narayana-jta</artifactId>
        </dependency>
        <dependency>
            <!-- The ObjectMapper HttpRepositoryNameResolver reads its one lookup response with. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jackson</artifactId>
        </dependency>
        <dependency>
            <!-- The REST surface at /githost/api (quarkus.rest.path), which the SPA reads and no
                 `git` client ever touches. quarkus-rest-jackson brings quarkus-rest with it and
                 adds the body writer that turns a record into JSON — the same Jackson the resolver
                 above already uses, so nothing new arrives in the image for it.

                 REST rather than another Vert.x route: the git routes are literals because git
                 owns their spelling, and nothing about that argument applies to an API a browser
                 calls. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <!-- The SPA. Quinoa runs the npm build in src/main/webui (the qits-spa-githost
                 submodule) during augmentation and serves the result as static resources — see the
                 quarkus.quinoa.* block in application.properties for the paths.

                 It is why quarkus-undertow must stay out: Quinoa's production static serving goes
                 through Quarkus' own static-resource route, which undertow's servlet stack takes
                 over and then cannot find (the monorepo's
                 docs/issues/2026-07-15_packaged-spa-not-served.md). Every git wire here is a raw
                 Vert.x route, which is what keeps that dependency absent. -->
            <groupId>io.quarkiverse.quinoa</groupId>
            <artifactId>quarkus-quinoa</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-postgresql</artifactId>
        </dependency>
        <dependency>
            <!-- The datasource resilience jar, and it is a RUNTIME concern spelled at compile
                 scope because both halves are used here: application.properties names
                 PatientPgDriver as the pool's driver, the catalog reads are wrapped in DbRetry,
                 and the catalog write in DbRetry.inNewTx. It brings pgjdbc and narayana-jta in
                 provided scope only — quarkus-jdbc-postgresql above is where the real driver comes
                 from, and this service already has JTA. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-db-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway</artifactId>
        </dependency>
        <dependency>
            <!-- Flyway 10 split its database support out of core; without this the postgres
                 lineages have no dialect and migrate-at-start fails at the first statement. -->
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <!-- OTLP export to qits-observability, on the same settings every other service ships.
                 Dark outside a deployment (see application.properties). -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <!-- JGit core only (UploadPack/ReceivePack + the pkt-line protocol). GitHostRoutes
                 drives these directly from Vert.x routes, so we need NEITHER a servlet container
                 NOR jgit.http.server. JGit speaks the wire protocol ONLY. -->
            <groupId>org.eclipse.jgit</groupId>
            <artifactId>org.eclipse.jgit</artifactId>
        </dependency>

        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The platform's shared rules. Only the datasource baseline is enabled here (see
                 DatasourceBaselineTest): a datasource that lost a line of the three-line block
                 fails this build rather than a review. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-arch-rules</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Named per architecture on purpose: the binaries are separate artifacts and zonky
                 picks one at run time, so an unnamed arch fails in the middle of a suite rather
                 than during resolution. -->
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-linux-amd64</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-linux-arm64v8</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-darwin-arm64v8</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- This module is the DEPLOYABLE, and `<packaging>quarkus</packaging>` above is
                     what says so: it binds generate-code, generate-code-tests and build into the
                     lifecycle, so augmentation is not an execution someone can misplace. -->
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- GraalVM native build: `-Dnative` disables the fast-jar and enables the native image. It
             lives in THIS module because only this module is an application. -->
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <quarkus.package.jar.enabled>false</quarkus.package.jar.enabled>
                <skipITs>false</skipITs>
                <quarkus.native.enabled>true</quarkus.native.enabled>
            </properties>
        </profile>
    </profiles>
</project>
