<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.wohlben.qits</groupId>
        <artifactId>qits-githost</artifactId>
        <version>2026.825.141202</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- qits-githost's event vocabulary: what a push announces to the platform. Four records —
         SCMPublishCommit, SCMPublishTag, SCMDeleteBranch, SCMDeleteTag.

         A module of its own, between `eventstream` and everything else, for one reason: a
         vocabulary is what a CONSUMER needs, and nothing else in this repo is. qits-ci and
         qits-projects depend on this jar and get the records plus the bus and no part of the git
         host — which is why the split is here rather than a package inside `service`.

         It depends on `eventstream` and on nothing else, not even quarkus-arc: these are plain
         records, and a data module that cannot boot a container cannot grow a service.

         Modelled on services/qits-ci/ci-events, which is the same shape for the same reason. -->
    <artifactId>qits-githost-events</artifactId>
    <name>qits-githost :: events</name>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-eventstream</artifactId>
        </dependency>
        <dependency>
            <!-- Plain JUnit 5, not quarkus-junit5: nothing here is a @QuarkusTest. The suite drives
                 plain constructors and the canonical serializer, which needs no container. -->
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
